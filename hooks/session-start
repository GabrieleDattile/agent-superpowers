   ___                    __     ____                                                          
  / _ | ___ ____ ___  __ / /_   / __/__ _____  ___ ______  ___ _    _____ _______
 / __ |/ _ `/ -_) _ \/ // / __/  _\ \/ // / _ \/ -_) __/ _ \/ _ \ |/|/ / -_) __(_-<
/_/ |_|\_, /\__/_//_/\_,_/\__/  /___/\_,_/ .__/\__/_/ / .__/\___/__,__/\__/_/ /___/
      /___/                              /_/          /_/                          
EOF
echo -e "${RESET}"
echo -e "${GREEN}✔ Agent Superpowers v1.2.0 active.${RESET} [9 autonomous skills loaded]"
echo -e "${YELLOW}>> Directives:${RESET} Worktree isolation enforced • TDR Red-Green required • Red-team audit active."
echo -e "Type ${CYAN}\"Tell me about your superpowers\"${RESET} anytime to inspect your active capabilities.\n"
